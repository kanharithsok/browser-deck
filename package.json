{
  "name": "browser-deck",
  "productName": "BrowserDeck",
  "version": "1.2.0",
  "private": true,
  "description": "Multiple real browser sessions. One flexible workspace.",
  "author": "BrowserDeck contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "npm run package:dir && node scripts/start-packaged.mjs",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:dir": "npm run build && electron-builder --mac --arm64 --dir --publish never",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "axe-core": "4.11.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.14"
  }
}
